# agent-os build configuration.
#
# Each line is load-bearing; the comment says WHY so the next reader can extend
# without re-deriving it (C1). The graph is declared in MODULE.bazel and its
# include() slices.

# Bzlmod only — no legacy WORKSPACE.
common --enable_workspace=false

# Tests and tools locate inputs via runfiles, never hardcoded paths. This is what
# kills the memcontainers `../../target/...` staleness class at the source (§2.2).
common --enable_runfiles

# Hermetic actions: the action environment is the declared one, not the caller's
# shell. No tool leaks in from $PATH (B4).
common --incompatible_strict_action_env

# Third-party C/C++ (sqlite, luauc) is compiled by the hermetic `zig cc`; silence
# upstream warnings so they don't drown our own diagnostics.
common --copt=-w
common --host_copt=-w

# zig cc enables UBSan by default. Native git-engine (and other C/Zig host
# objects) do unaligned loads in pack/hash paths; disable so smoke/abi tests
# do not abort under zig cc.
build --copt=-fno-sanitize=undefined --host_copt=-fno-sanitize=undefined
build --linkopt=-fno-sanitize=undefined --host_linkopt=-fno-sanitize=undefined

# No global target platform: host-side tools (the contracts projector, the
# wasmtime host, the Elixir server via its scoped transition) build for the
# autodetected host. //platforms:host_musl is an optional per-target platform
# for a future statically linked host; it is not forced on the repo and is not
# matching a prebuilt libwasmtime.a (wasmtime is built from @host_crates).
# Kernel and guest targets transition to //platforms:wasm32_freestanding via
# the Zig wasm toolchain regardless of this default.

# Show what actually failed, not a wall of passing output.
test --test_output=errors

# Release/package provenance is sourced from the checked-out Git revision. The
# package rule rejects a dirty marker rather than publishing false provenance.
build --workspace_status_command=bazel/workspace_status.sh

# TypeScript: tsc is the transpiler — typecheck + JS emit in one pass, no swc/babel lane to keep in
# sync. rules_ts requires an explicit choice; this is it, repo-wide.
common --@aspect_rules_ts//ts:default_to_tsc_transpiler

# --- Elixir control-plane lane (//server) — see bazel/erlang.MODULE.bazel ------
# Registries are GLOBAL because Bzlmod module resolution is global. The rabbitmq
# erlang-packages registry is only consulted for modules absent from the BCR (the erlang hex
# deps), and the BCR stays FIRST, so existing resolutions are unchanged. Specifying any
# --registry replaces the default list, so the BCR must be named explicitly.
common --registry=https://bcr.bazel.build/
common --registry=https://raw.githubusercontent.com/rabbitmq/bazel-central-registry/erlang-packages/

# The normal Elixir workflow is config-free:
#
#   bazel test //server:mix_test
#   bazel build //server:agent_os_package
#
# Those public targets use //bazel:elixir_transition.bzl to scope rules_erlang's
# dual-platform setup to the dependency edge into //server. That avoids flipping
# the top-level --host_platform/--platforms, which would invalidate Bazel's
# analysis cache when switching back to the wasm/Rust/Zig graph. Keep this
# config only as a low-level escape hatch for direct implementation targets
# such as //server:mix_test_impl.
build:elixir --host_platform=//platforms:erlang_internal_platform
build:elixir --platforms=//platforms:erlang_linux_26_2_platform

# Machine-local output and Zig cache placement belongs in this ignored file.
try-import %workspace%/user.bazelrc

