# Zig toolchain, C headers, skylib, and the Gitz / utilz / shcore modules.
#
# Zig is the hermetic compiler for the shell, coreutils, sysroot, guest glue, and
# C/C++ (sqlite via zig cc; Luau via the luauc module). rules_cc is only for
# cc_import/cc_library header targets. skylib is build_test / diff_test / write_file.

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_zig", version = "0.16.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

# Zig 0.16.0 toolchain, pinned via the local sha-locked index.
zig = use_extension("@rules_zig//zig:extensions.bzl", "zig")
zig.index(file = "//:zig_index.json")
zig.toolchain(zig_version = "0.16.0")
use_repo(zig, "zig_toolchains")

# Cross-compile-to-wasm zig toolchains, registered in the root MODULE.bazel:
# //platforms:wasm32_freestanding (the Rust kernel + pure guests, no libc) and
# //platforms:wasm32_wasi (C/C++ domain tools whose runtime needs zig's
# wasi-libc/libc++; //memcontainers/wasi-adapter then rewrites the syscall
# imports to mc).

# Gitz — pure-Zig Git library (go-git v5.19.2 port). Commit-locked 0.0.0
# archive_override: bump commit + integrity together.
GITZ_COMMIT = "f18b320da479737e2920aca94bdd902ed68fb3b1"

GITZ_INTEGRITY = "sha256-6Nk0pK/XJea5Ry4hCXZWYbAOTmP8k3hF/iJJSccoLXA="

bazel_dep(name = "gitz", version = "0.0.0")
archive_override(
    module_name = "gitz",
    integrity = GITZ_INTEGRITY,
    strip_prefix = "gitz-" + GITZ_COMMIT,
    url = "https://github.com/OpytAI/gitz/archive/" + GITZ_COMMIT + ".tar.gz",
)

# utilz — Unix utilities in Zig. Commit-locked 0.0.0 archive_override:
# bump commit + strip_prefix + integrity together.
UTILZ_COMMIT = "d0d6f37893821de193e55eb40fecc08e70c4c3ba"

UTILZ_INTEGRITY = "sha256-SxdWsaaCOrRcPeKhjFzRA6/O0EQ7PO9QhjMqUIZ+74s="

bazel_dep(name = "utilz", version = "0.0.0")
archive_override(
    module_name = "utilz",
    integrity = UTILZ_INTEGRITY,
    strip_prefix = "utilz-" + UTILZ_COMMIT,
    url = "https://github.com/OpytAI/utilz/archive/" + UTILZ_COMMIT + ".tar.gz",
)

# shcore — embed a Unix shell anywhere. Same pin rule as gitz/utilz.
SHCORE_COMMIT = "779fe0c5e6f2e7a417a6c60c14aa77d16c703262"

SHCORE_INTEGRITY = "sha256-jvAqvi1K11LVByyBh95kyJvQu5KzSaN0XDpf9yAq0Cg="

bazel_dep(name = "shcore", version = "0.0.0")
archive_override(
    module_name = "shcore",
    integrity = SHCORE_INTEGRITY,
    strip_prefix = "shcore-" + SHCORE_COMMIT,
    url = "https://github.com/OpytAI/shcore/archive/" + SHCORE_COMMIT + ".tar.gz",
)
