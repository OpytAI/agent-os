load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel:rust_opt_test.bzl", "rust_opt_test")

# tools/mc-stamp — append mc_tier / mc_budget / mc_service / mc_applets custom sections the
# kernel reads at exec. Zig linksection is a data segment, not a custom section, so all Zig/C++
# guests are stamped here; Rust guests are stamped the same way from BUILD attrs (`mc_program`),
# not from source macros. A native std CLI (it edits a guest wasm); no deps.
rust_binary(
    name = "mc-stamp",
    srcs = ["src/main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
)

# The strip-then-append idempotency, unit-tested: a re-stamp replaces rather than duplicates.
rust_opt_test(
    name = "test",
    size = "small",
    crate = ":mc-stamp",
    edition = "2021",
)
