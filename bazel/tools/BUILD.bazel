load("@npm//:@johnnymorganz/stylua-bin/package_json.bzl", stylua_bin = "bin")
load("@npm//:@wasm-fmt/clang-format/package_json.bzl", clang_format_bin = "bin")
load("@npm//:oxfmt/package_json.bzl", oxfmt_bin = "bin")
load("@rules_multirun//:defs.bzl", "multirun")
load("//bazel:elixir_transition.bzl", "elixir_binary")
load("//bazel/tools/format:defs.bzl", "source_formatter")
load("//bazel/tools/format:js_tool.bzl", "js_tool")
load("//bazel/tools/format:zig.bzl", "zig_formatter")

package(default_visibility = ["//visibility:public"])

oxfmt_bin.oxfmt_binary(name = "oxfmt_bin")

stylua_bin.stylua_binary(name = "stylua_bin")

clang_format_bin.clang_format_binary(name = "clang_format_bin")

js_tool(
    name = "oxfmt",
    actual = ":oxfmt_bin",
)

js_tool(
    name = "stylua",
    actual = ":stylua_bin",
)

js_tool(
    name = "clang_format",
    actual = ":clang_format_bin",
)

zig_formatter(name = "zig_fmt")

elixir_binary(
    name = "elixir_fmt",
    actual = "//bazel/tools/format:elixir_fmt_tool",
)

source_formatter(
    name = "format_c_cpp",
    language = "c_cpp",
    tool = ":clang_format",
)

source_formatter(
    name = "format_rust",
    language = "rust",
    tool = "@rules_rust//tools/upstream_wrapper:rustfmt",
)

source_formatter(
    name = "format_shell",
    language = "shell",
    tool = "@multitool//tools/shfmt",
)

source_formatter(
    name = "format_starlark",
    language = "starlark",
    tool = "@buildifier_prebuilt//:buildifier",
)

source_formatter(
    name = "format_oxc",
    language = "oxc",
    tool = ":oxfmt",
)

source_formatter(
    name = "format_zig",
    language = "zig",
    tool = ":zig_fmt",
)

source_formatter(
    name = "format_elixir",
    language = "elixir",
    tool = ":elixir_fmt",
)

source_formatter(
    name = "format_luau",
    language = "luau",
    tool = ":stylua",
)

multirun(
    name = "format",
    commands = [
        ":format_c_cpp",
        ":format_rust",
        ":format_shell",
        ":format_starlark",
        ":format_oxc",
        ":format_zig",
        ":format_elixir",
        ":format_luau",
    ],
    jobs = 4,
    keep_going = True,
    print_command = True,
)

multirun(
    name = "format.check",
    commands = [
        ":format_c_cpp.check",
        ":format_rust.check",
        ":format_shell.check",
        ":format_starlark.check",
        ":format_oxc.check",
        ":format_zig.check",
        ":format_elixir.check",
        ":format_luau.check",
    ],
    jobs = 4,
    keep_going = True,
    print_command = True,
)
