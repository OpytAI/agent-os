# Format and contract-drift host tools.
#
# aspect_bazel_lib — write_source_files + diff_test for the contract drift gate (B2).
# buildifier_prebuilt + rules_multitool + rules_multirun — //bazel/tools format.

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")
bazel_dep(name = "rules_multirun", version = "0.11.0")
bazel_dep(name = "rules_multitool", version = "0.11.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//bazel/tools/format:multitool.lock.json")
use_repo(multitool, "multitool")
