load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("//memcontainers/hosts/wasmtime:defs.bzl", "host_release_shared_library")

# Table discovery reports the staged capabilities explicitly. The C loader
# exercises the release artifact with the real kernel and base image.
rust_shared_library(
    name = "mc_host",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "mc_host",
    edition = "2021",
    compile_data = ["mc_host.map"],
    rustc_flags = [
        "-Clink-arg=-Wl,--exclude-libs,ALL",
        "-Clink-arg=-Wl,--version-script=memcontainers/hosts/wasmtime/c/mc_host.map",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//memcontainers/contracts:embedder_rust",
        "//memcontainers/contracts:ctl_rust",
        "//memcontainers/contracts:constants_rust",
        "//memcontainers/contracts:snapshot_rust",
        "//memcontainers/hosts/wasmtime:lib",
    ],
)

host_release_shared_library(
    name = "mc_host_release",
    out = "libmc_host.so",
    lib = ":mc_host",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "headers",
    hdrs = ["include/mc_host.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//memcontainers/contracts:ctl_c",
        "//memcontainers/contracts:embedder_c",
    ],
)

cc_test(
    name = "abi_layout_test",
    srcs = ["test/abi_layout.c"],
    deps = [":headers"],
)

cc_test(
    name = "cpp_header_test",
    srcs = ["test/header.cc"],
    deps = [":headers"],
)

cc_test(
    name = "loader_test",
    srcs = ["test/loader.c"],
    args = ["$(location :mc_host_release)"],
    data = [":mc_host_release"],
    linkopts = ["-ldl"],
    deps = [":headers"],
)

cc_test(
    name = "native_lifecycle_test",
    srcs = ["test/native_lifecycle.c"],
    args = [
        "$(location :mc_host_release)",
        "$(location //memcontainers/kernel/rust:kernel)",
        "$(location //memcontainers/images:loom)",
        "$(location //memcontainers/images:base)",
        "$(location //memcontainers/hosts/wasmtime:cross_host_snapshot)",
        "$(location //memcontainers/hosts/wasmtime:cross_host_incremental_snapshot)",
    ],
    data = [
        ":mc_host_release",
        "//memcontainers/kernel/rust:kernel",
        "//memcontainers/images:loom",
        "//memcontainers/images:base",
        "//memcontainers/hosts/wasmtime:cross_host_snapshot",
        "//memcontainers/hosts/wasmtime:cross_host_incremental_snapshot",
    ],
    linkopts = ["-ldl", "-pthread"],
    deps = [":headers"],
)
