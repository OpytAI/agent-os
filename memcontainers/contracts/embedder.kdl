message "AttachmentDefinition" id=20 version=1 {
  field "kind" type="u32"
  field "payload" type="bytes"
  doc "Versioned closed attachment variant. The generated kind table defines the payload message."
}

message "OperationRequest" id=21 version=1 {
  field "kind" type="u32"
  field "payload" type="bytes"
  doc "One asynchronous host-control request. Payload is the generated kind-specific message."
}

message "OperationResult" id=22 version=1 {
  field "kind" type="u32"
  field "status" type="i32"
  field "payload" type="bytes"
  doc "One asynchronous host-control terminal value. Guest status remains data."
}

message "EffectEvent" id=23 version=1 {
  field "kind" type="u32"
  field "event_id" type="i64"
  field "vm_id" type="i64"
  field "operation_id" type="i64" opt=1
  field "socket_id" type="i64" opt=1
  field "flags" type="u32"
  field "payload" type="bytes"
  doc "Generation-bound, typed native-host effect envelope."
}

message "EffectResponse" id=24 version=1 {
  field "kind" type="u32"
  field "event_id" type="i64"
  field "payload" type="bytes"
  doc "Exactly one kind-matched terminal response for an effect event."
}

message "AttachmentManifestEntry" id=25 version=1 {
  field "kind" type="u32"
  field "identity" type="str"
  field "digest" type="bytes"
  doc "Non-secret attachment identity included in strict-restore companion metadata."
}

message "AttachmentManifest" id=26 version=1 {
  field "entries" type="list<AttachmentManifestEntry>"
  doc "Canonical non-secret attachment manifest. Credentials and callback addresses are absent."
}

message "FilesystemRequest" id=27 version=1 {
  field "path" type="str"
  field "data" type="bytes" opt=1
  field "target" type="str" opt=1
  field "mode" type="u32" opt=1
  doc "One native filesystem control attempt. The operation kind selects and validates the required fields."
}

message "LayerCommitResult" id=28 version=1 {
  field "digest" type="str"
  field "layer" type="bytes"
  doc "Content-addressed layer produced by mc_commit_layer."
}

message "HostCallAttachment" id=29 version=1 {
  field "name" type="str"
  field "identity" type="str"
  doc "One application-provided host-call route and its non-secret stable identity."
}

message "MountRequest" id=30 version=1 {
  field "path" type="str"
  field "read_only" type="bool"
  doc "Mount a plan-registered host-call driver at its own path."
}

message "HostCallEvent" id=31 version=1 {
  field "name" type="str"
  field "request" type="bytes"
  doc "Binary-safe request delivered to an application host-call route."
}

message "HostCallResponse" id=32 version=1 {
  field "failed" type="bool"
  field "body" type="bytes"
  doc "One whole host-call response; the kernel has no body-pending sentinel."
}

message "EffectCancel" id=33 version=1 {
  field "original_event_id" type="i64"
  doc "One cancellation notice for a leased effect. Acknowledgment retires the original lease."
}

message "PersistAttachment" id=34 version=1 {
  field "identity" type="str"
  doc "Non-secret identity of the application persistence provider."
}

message "PersistEffectRequest" id=35 version=1 {
  field "key" type="bytes"
  field "value" type="bytes" opt=1
  doc "Typed persistence request. The event kind selects get, put, delete, or list."
}

message "PersistEffectResponse" id=36 version=1 {
  field "failed" type="bool"
  field "body" type="bytes"
  doc "One complete persistence result delivered before kernel poll reports ready."
}

message "HttpApplicationAttachment" id=37 version=1 {
  field "identity" type="str"
  doc "Non-secret identity of the application HTTP transport. Connection markers are refused."
}

message "HttpEffectRequest" id=38 version=1 {
  field "request" type="bytes"
  doc "Unmarked kernel HTTP request blob. No credential is injected by this transport."
}

message "HttpEffectResponse" id=39 version=1 {
  field "failed" type="bool"
  field "head" type="bytes"
  field "body" type="bytes"
  doc "Complete HTTP response. The head is at most the kernel HEAD_BUF size."
}

message "WsConnectRequest" id=40 version=1 {
  field "url" type="str"
  doc "Guest WebSocket URL presented to the application transport."
}

message "WsConnectResponse" id=41 version=1 {
  field "failed" type="bool"
  doc "Handshake completion. A failed handshake wakes the guest with an error."
}

message "WsSendRequest" id=42 version=1 {
  field "data" type="bytes"
  doc "One guest WebSocket message held under the per-socket send credit."
}

message "WsSendResponse" id=43 version=1 {
  field "failed" type="bool"
  doc "Send completion releases credit; failure closes the guest socket."
}

message "WsCloseEvent" id=44 version=1 {
  field "reason" type="u32"
  doc "Close notification for an application-owned WebSocket connection."
}

message "CatalogRecord" id=45 version=1 {
  field "sha" type="str"
  field "bytes" type="bytes"
  doc "One complete content-addressed catalog shard to stage before apply."
}

message "CatalogApplyRequest" id=46 version=1 {
  field "index_json" type="bytes"
  field "base_digest" type="str"
  field "records" type="list<CatalogRecord>"
  doc "Transactional live catalog update. Base digest is required; every indexed shard is supplied."
}
