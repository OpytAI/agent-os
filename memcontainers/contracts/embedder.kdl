// contracts/embedder.kdl — application → native wasmtime-host embedding boundary.
//
// This contract owns the native adapter's values and portable envelopes. It does
// not redefine the kernel bridge, control, or MCSN snapshot protocols. Interface
// IDs and operation kinds reserve names; feature discovery determines availability.
// Layout entries are the stable v1 manifest for the public C declarations and
// their Rust FFI mirrors. Generated constants are checked by both compilers.

abi-version major=1 minor=0

layout "HEADER" size=8 align=4 {
  offset "size" value=0
  offset "version" value=4
  offset "flags" value=6
}
layout "BUFFER" size=24 align=8 {
  offset "data" value=0
  offset "capacity" value=8
  offset "required" value=16
}
layout "ERROR" size=48 align=8 {
  offset "header" value=0
  offset "domain" value=8
  offset "code" value=12
  offset "retryable" value=16
  offset "reserved" value=17
  offset "message" value=24
}
layout "RUNTIME_OPTIONS" size=36 align=4 {
  offset "header" value=0
  offset "max_vms" value=8
  offset "max_drive_ticks" value=12
  offset "max_output_bytes" value=16
  offset "max_output_records" value=20
  offset "max_snapshot_bytes" value=24
  offset "max_snapshot_total_bytes" value=28
  offset "max_operations_per_vm" value=32
}
layout "LIBRARY_INFO" size=24 align=8 {
  offset "header" value=0
  offset "abi_major" value=8
  offset "abi_minor" value=10
  offset "implementation_table_size" value=12
  offset "feature_bits" value=16
}
layout "API" size=56 align=8 {
  offset "header" value=0
  offset "abi_major" value=8
  offset "abi_minor" value=10
  offset "implementation_table_size" value=12
  offset "feature_bits" value=16
  offset "runtime_create" value=24
  offset "runtime_close" value=32
  offset "library_info" value=40
  offset "get_interface" value=48
}
layout "BYTES" size=16 align=8 {
  offset "data" value=0
  offset "len" value=8
}
layout "KERNEL_INFO" size=40 align=4 {
  offset "header" value=0
  offset "digest" value=8
}
layout "VM_CREATE_OPTIONS" size=56 align=8 {
  offset "header" value=0
  offset "layers" value=8
  offset "layer_count" value=16
  offset "contract_tier" value=24
  offset "contract_budget_mib" value=28
  offset "contract_fuel" value=32
  offset "requested_workers" value=40
  offset "flags" value=44
  offset "terminal_cols" value=48
  offset "terminal_rows" value=52
}
layout "VM_RESTORE_OPTIONS" size=48 align=8 {
  offset "header" value=0
  offset "snapshot" value=8
  offset "baseline" value=24
  offset "mode" value=40
  offset "reserved" value=44
}
layout "DRIVE_OPTIONS" size=24 align=8 {
  offset "header" value=0
  offset "max_ticks" value=8
  offset "reserved" value=12
  offset "stop_mask" value=16
}
layout "VM_STATUS" size=64 align=8 {
  offset "header" value=0
  offset "state" value=8
  offset "last_tick" value=12
  offset "flags" value=16
  offset "exit_code" value=20
  offset "output_records" value=24
  offset "output_bytes" value=32
  offset "output_dropped_bytes" value=40
  offset "inflight_egress" value=48
  offset "pending_commits" value=52
  offset "workers" value=56
  offset "reserved" value=60
}
layout "DRIVE_RESULT" size=80 align=8 {
  offset "header" value=0
  offset "ticks" value=8
  offset "stop_reason" value=12
  offset "status" value=16
}
layout "VM_API" size=88 align=8 {
  offset "header" value=0
  offset "kernel_load" value=8
  offset "kernel_close" value=16
  offset "vm_create" value=24
  offset "vm_restore" value=32
  offset "vm_status" value=40
  offset "vm_drive" value=48
  offset "vm_close" value=56
  offset "vm_cancel_and_close" value=64
  offset "terminal_input" value=72
  offset "terminal_resize" value=80
}
layout "OUTPUT_RECORD" size=64 align=8 {
  offset "header" value=0
  offset "kind" value=8
  offset "channel" value=12
  offset "sequence" value=16
  offset "byte_offset" value=24
  offset "length" value=32
  offset "first_lost_sequence" value=40
  offset "last_lost_sequence" value=48
  offset "byte_end" value=56
}
layout "OUTPUT_STATS" size=48 align=8 {
  offset "header" value=0
  offset "records" value=8
  offset "retained_bytes" value=16
  offset "dropped_bytes" value=24
  offset "leased_records" value=32
  offset "flags" value=40
  offset "reserved" value=44
}
layout "OUTPUT_API" size=48 align=8 {
  offset "header" value=0
  offset "next" value=8
  offset "read" value=16
  offset "ack" value=24
  offset "release" value=32
  offset "stats" value=40
}
layout "SNAPSHOT_BEGIN_OPTIONS" size=24 align=8 {
  offset "header" value=0
  offset "mode" value=8
  offset "reserved" value=12
  offset "baseline" value=16
}
layout "SNAPSHOT_INFO" size=128 align=8 {
  offset "header" value=0
  offset "kind" value=8
  offset "mcsn_version" value=12
  offset "kernel_digest" value=16
  offset "baseline_id" value=48
  offset "content_digest" value=80
  offset "length" value=112
  offset "memory_len" value=120
}
layout "SNAPSHOT_READINESS" size=32 align=4 {
  offset "header" value=0
  offset "inflight_egress" value=8
  offset "pending_commits" value=12
  offset "pending_operations" value=16
  offset "pending_effects" value=20
  offset "pending_transactions" value=24
  offset "reserved" value=28
}
layout "SNAPSHOT_API" size=72 align=8 {
  offset "header" value=0
  offset "baseline_import" value=8
  offset "baseline_close" value=16
  offset "begin" value=24
  offset "read" value=32
  offset "finish" value=40
  offset "cancel" value=48
  offset "inspect" value=56
  offset "readiness" value=64
}
layout "OPERATION_STATUS" size=32 align=8 {
  offset "header" value=0
  offset "kind" value=8
  offset "state" value=12
  offset "error" value=16
  offset "reserved" value=20
  offset "result_length" value=24
}
layout "OPERATION_API" size=56 align=8 {
  offset "header" value=0
  offset "start" value=8
  offset "poll" value=16
  offset "result" value=24
  offset "peek" value=32
  offset "cancel" value=40
  offset "close" value=48
}
layout "ATTACHMENT_API" size=40 align=8 {
  offset "header" value=0
  offset "plan_create" value=8
  offset "plan_add" value=16
  offset "plan_seal" value=24
  offset "plan_close" value=32
}
layout "EFFECT_INFO" size=24 align=8 {
  offset "header" value=0
  offset "kind" value=8
  offset "reserved" value=12
  offset "length" value=16
}
layout "EFFECT_API" size=96 align=8 {
  offset "header" value=0
  offset "next" value=8
  offset "read" value=16
  offset "release" value=24
  offset "respond" value=32
  offset "ack" value=40
  offset "response_begin" value=48
  offset "response_write" value=56
  offset "response_finish" value=64
  offset "response_abort" value=72
  offset "socket_push" value=80
  offset "socket_close" value=88
}

