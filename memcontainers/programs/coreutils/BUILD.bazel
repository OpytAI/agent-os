load(":defs.bzl", "coreutils_box")
load("//bazel/tools/size:defs.bzl", "size_limit")

# programs/coreutils — AgentOS mc adapter over @utilz. Output labels stay
# mcbox-*_opt so images and mc-roster do not churn.

_TIERS = {
    "isolated": "isolated",
    "readonly": "read-only",
    "readwrite": "read-write",
    "full": "full",
}

_SETS = {
    "": "full",
    "min-": "min",
}

[
    coreutils_box(
        name = "mcbox-" + infix + tier,
        set_kind = set_kind,
        tier = tier,
        tier_section = tier_section,
    )
    for tier, tier_section in _TIERS.items()
    for infix, set_kind in _SETS.items()
]

# Measured 21553 bytes from `bazel build :mcbox-min-isolated_opt`; +4096 slack.
size_limit(
    name = "mcbox_min_isolated_size_limit",
    file = ":mcbox-min-isolated_opt",
    max_bytes = 25649,
)
