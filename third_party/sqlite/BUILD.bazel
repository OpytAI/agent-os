# sqlite guest: amalgamation via sqlite.MODULE.bazel http_archive (no core patches).
# Zig serve loop is //memcontainers/programs/sqlite/glue; this package only exports
# BUILD.sqlite.bazel. 3.51.0 has native SQLITE_WASI support — compile defines live in
# glue/BUILD.bazel. The build stamps mc_tier / mc_budget / mc_service so /bin/sqlite is
# both a one-shot CLI and a resident service from one binary.

# Exported so http_archive(build_file = "//third_party/sqlite:BUILD.sqlite.bazel") can apply it to the
# extracted @sqlite source.
exports_files([
    "BUILD.sqlite.bazel",
    "sqlite.MODULE.bazel",
])
